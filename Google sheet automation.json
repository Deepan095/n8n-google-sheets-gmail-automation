        "jsCode": "const rows=$input.all().map(item=>item.json);const body=rows.map((row,index)=>{const course=row.Course??row['Course ']??'';return `${index+1}. Name: ${row.Name}\\n   Course: ${course}\\n   Status: ${row.Status}`;}).join('\\n\\n');return[{json:{subject:'Data Summary from Google Sheet',message:`Hi,\\n\\nHere is the latest data from the sheet:\\n\\n${body}\\n\\nRegards,\\nYour Automation Bot`}}];"
